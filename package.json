{
  "name": "pixelkit-sdk",
  "version": "1.6.8",
  "private": true,
  "description": "Monorepo for the PixelKit SDK: the hooks, and the two Kotlin Expo Modules they read hardware through.",
  "license": "MIT",
  "author": "Traves Theberge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelKit-Labs/pixelkit-sdk.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check-docs",
    "build": "npm run build -w @pixelkit-labs/sdk -w @pixelkit-labs/native -w @pixelkit-labs/mlkit",
    "sync-versions": "node scripts/sync-versions.js",
    "check-docs": "node scripts/check-docs-contract.js",
    "test:e2e": "node scripts/run-artemis-e2e.js",
    "test:e2e:flash": "node scripts/run-artemis-e2e.js --profile flash",
    "test:e2e:pro": "node scripts/run-artemis-e2e.js --profile pro",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@google/genai": "^2.21.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-battery": "~57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-cellular": "~57.0.1",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.16",
    "expo-mcp": "~0.2.1",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sensors": "~57.0.2",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "@pixelkit-labs/sdk": "1.6.8",
    "@pixelkit-labs/native": "1.6.8",
    "@pixelkit-labs/mlkit": "1.6.8"
  }
}
