{
  "name": "@pixelkit-labs/native",
  "version": "1.6.13",
  "description": "Pixel hardware for Expo apps: SoC identity, CPU clusters, memory, thermal and ADPF headroom, display modes, GPU, torch and haptic envelopes. Zero third-party dependencies. Android only.",
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "android",
    "pixel"
  ],
  "license": "MIT",
  "author": "Traves Theberge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelKit-Labs/pixelkit-sdk.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/PixelKit-Labs/pixelkit-sdk#readme",
  "bugs": {
    "url": "https://github.com/PixelKit-Labs/pixelkit-sdk/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "index.ts",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync(process.argv[1],{recursive:true,force:true})\" build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "expo": "~57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
