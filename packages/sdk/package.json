{
  "name": "@pixelkit-labs/sdk",
  "version": "1.6.44",
  "description": "PixelKit is an SDK for building Expo and React Native applications on Google Pixel devices. It provides typed React hooks for the CPU, GPU and TPU, device sensors, radios, secure hardware, camera and audio, display and power telemetry, haptics, on-device AI, and Cloud AI.",
  "keywords": [
    "expo",
    "react-native",
    "android",
    "pixel",
    "on-device-ai",
    "gemini-nano",
    "mlkit",
    "offline-translation",
    "document-scanner",
    "speech-to-text",
    "hardware",
    "telemetry",
    "uwb",
    "nfc"
  ],
  "license": "MIT",
  "author": "Traves Theberge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelKit-Labs/pixelkit-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/PixelKit-Labs/pixelkit-sdk#readme",
  "bugs": {
    "url": "https://github.com/PixelKit-Labs/pixelkit-sdk/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "README.md",
    "LICENSE",
    "mlkit.js",
    "mlkit.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync(process.argv[1],{recursive:true,force:true})\" build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pixelkit-labs/native": "1.6.44"
  },
  "peerDependencies": {
    "@google/genai": "^2.21.0",
    "@pixelkit-labs/mlkit": "1.6.44",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-battery": "~57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-camera": "~57.0.4",
    "expo-cellular": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.16",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sensors": "~57.0.2",
    "expo-speech": "~57.0.2",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "peerDependenciesMeta": {
    "@pixelkit-labs/mlkit": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./mlkit": {
      "types": "./build/mlkit.d.ts",
      "default": "./build/mlkit.js"
    },
    "./package.json": "./package.json"
  }
}
